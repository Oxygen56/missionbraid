{
  "name": "missionbraid",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Agent Runtime Workbench for native coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "bin": {
    "missionbraid": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
